---
import Link from "./ui/Link.astro";

interface Props {
	news: {
		title: string;
		tag: string;
		image: string;
		alt: string;
		excerpt: string;
		author?: string;
		date: Date;
	};
	href: string;
}

const { news, href } = Astro.props;
const formattedDate = news.date.toLocaleDateString("es-ES", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<article class="flex flex-col border border-black/10 bg-white">
	<a href={href}>
		<img src={news.image} alt={news.alt} class="aspect-[16/9] w-full object-cover" />
	</a>
	<div class="flex flex-1 flex-col gap-3 p-6">
		<span
			class="w-fit bg-[#B4552D] px-3 py-1 font-sans text-xs uppercase tracking-widest text-white"
		>
			{news.tag}
		</span>
		<h3 class="font-serif-bold text-xl leading-snug text-black">
			<a href={href} class="hover:text-[#B4552D]">{news.title}</a>
		</h3>
		<p class="font-sans text-sm leading-relaxed text-neutral-600">{news.excerpt}</p>
		<div
			class="mt-auto flex items-center justify-between border-t border-black/10 pt-4"
		>
			<span class="font-sans text-sm text-neutral-500"
				>{news.author ? `Escrito por ${news.author}` : formattedDate}</span
			>
			<Link href={href} arrow>Leer noticia</Link>
		</div>
	</div>
</article>