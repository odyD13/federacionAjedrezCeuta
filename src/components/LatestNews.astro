---
import { news } from "../data/news";
import Button from "./ui/Button.astro";
import Link from "./ui/Link.astro";

interface Props {
	hideCta?: boolean;
}

const { hideCta = false } = Astro.props;

const latest = news.slice(0, 3);
const [featured, ...side] = latest;
---

<section id="noticias" class="bg-white px-6 py-16 md:px-16 md:py-20 lg:px-24">
	<h2
		class="relative before:content-[''] before:block before:w-[60px] before:h-1 before:bg-[#B4552D] before:absolute before:-bottom-2 font-serif-bold text-2xl uppercase tracking-wide text-black md:text-3xl"
	>
		Últimas noticias
	</h2>

	<div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-5">
		<article class="flex flex-col md:col-span-3">
			<img
				src={featured.image}
				alt={featured.alt}
				class="aspect-[16/9] w-full object-cover"
			/>
			<div class="flex flex-col gap-4 pt-5">
				<span
					class="w-fit bg-[#B4552D] px-3 py-1 font-sans text-xs uppercase tracking-widest text-white"
				>
					{featured.tag}
				</span>
				<h3 class="font-serif-bold text-2xl text-black md:text-3xl">
					{featured.title}
				</h3>
				<p class="font-sans leading-relaxed text-neutral-600">
					{featured.excerpt}
				</p>
				<div
					class="flex items-center justify-between border-t border-black/10 pt-4"
				>
					<span class="font-sans text-sm text-neutral-500"
						>{featured.author ? `Escrito por ${featured.author}` : featured.date}</span
					>
					<Link href="#" arrow>Leer noticia</Link>
				</div>
			</div>
		</article>

		<div class="flex flex-col gap-6 md:col-span-2">
			{side.map((item) => (
				<article
					class="side-card relative hidden md:flex h-72 flex-1 flex-col justify-end overflow-hidden bg-black p-6"
				>
					<img
						src={item.image}
						alt={item.alt}
						class="absolute inset-0 inset inset-shadow-[0px 80px 50px 0px rgba(0,0,0,0.6)] h-full w-full object-cover opacity-70"
					/>
					<div class="relative">
						{item.date && (
							<p
								class="font-sans text-xs uppercase tracking-widest text-white/70"
							>
								{item.date}
							</p>
						)}
						<h3 class="mt-2 font-serif-bold text-xl text-white">
							{item.title}
						</h3>
					</div>
				</article>
			))}
		</div>
	</div>

	{!hideCta && (
		<div class="mt-16 flex justify-center">
			<Button href="/noticias" variant="primary">Ver noticias</Button>
		</div>
	)}
</section>

<style>
	.side-card img {
		transition: transform 500ms ease;
	}

	.side-card:hover img {
		transform: scale(1.05);
	}
</style>