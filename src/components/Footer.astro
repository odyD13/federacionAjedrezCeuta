---
import Instagram from "../assets/instagram.svg";
---

<footer id="contacto" class="border-t border-black/10 bg-white px-6 py-12">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-10 md:grid md:grid-cols-2 lg:grid-cols-4 lg:gap-8"
	>
		<div
			class="hidden md:flex flex-col justify-center items-center gap-4 text-center md:text-left"
		>
			<a
				href="/"
				class="overflow-hidden rounded-full border border-black/10"
				aria-label="Inicio"
			>
				<img
					src="/escudo.webp"
					alt="Escudo de la Federación de Ajedrez de Ceuta"
					width="64"
					height="64"
					class="block h-16 w-16 object-cover"
				/>
			</a>
		</div>

		<nav aria-label="Enlaces">
			<h2
				class="font-serif-bold text-sm uppercase tracking-[0.18em] text-black"
			>
				Enlaces
			</h2>
			<ul
				class="mt-4 flex flex-col gap-2 font-sans text-sm text-neutral-500"
			>
				<li>
					<a href="/" class="hover:text-black">Inicio</a>
				</li>
				<li>
					<a href="/noticias" class="hover:text-black">Noticias</a>
				</li>
				<li>
					<a href="/torneos" class="hover:text-black">Torneos</a>
				</li>
				<li>
					<a href="/contacto" class="hover:text-black">Contacto</a>
				</li>
			</ul>
		</nav>

		<nav aria-label="Legal">
			<h2
				class="font-serif-bold text-sm uppercase tracking-[0.18em] text-black"
			>
				Legal
			</h2>
			<ul
				class="mt-4 flex flex-col gap-2 font-sans text-sm text-neutral-500"
			>
				<li>
					<a href="#" class="hover:text-black">Aviso legal</a>
				</li>
				<li>
					<a href="#" class="hover:text-black"
						>Política de privacidad</a
					>
				</li>
				<li>
					<a href="#" class="hover:text-black">Política de cookies</a>
				</li>
			</ul>
		</nav>

		<div>
			<h2
				class="font-serif-bold text-sm uppercase tracking-[0.18em] text-black"
			>
				Contacto
			</h2>
			<ul
				class="mt-4 flex flex-col gap-2 font-sans text-sm text-neutral-500"
			>
				<li>
					<a
						href="mailto:federacionajedrezceuta@gmail.com"
						class="hover:text-black">federacionajedrezceuta@gmail.com</a
					>
				</li>
				<li>
					<a href="tel:+34646417837" class="hover:text-black"
						>+34 646 417 837</a
					>
				</li>
				<li>
					<a
						href="https://maps.app.goo.gl/LfALSLNWt3TmCvJ8A"
						class="hover:text-black"
						>Dirección: Casino Militar C. Camoens, 51001, Ceuta</a
					>
				</li>
			</ul>
			<ul class="mt-6 flex gap-4 font-sans text-sm">
				<li class="flex items-center gap-2">
					
					
					<a
					href="https://www.instagram.com"
					class="flex items-center gap-2 text-neutral-500 transition-colors hover:text-black"
					>
					<Instagram width={30} height={30}/>
					</a>
				</li>
			</ul>
		</div>
	</div>

	<div class="mt-10 border-t border-black/10 pt-6 text-center">
		<p class="font-sans text-sm text-neutral-500">
			© 2026 Federación de Ajedrez de Ceuta. Todos los derechos
			reservados.
		</p>
	</div>
</footer>
