---
import Button from "./ui/Button.astro";

interface Props {
	name: string;
	status: string;
	details: string[];
	date: string;
	place: string;
}

const { name, status, details, date, place } = Astro.props;

const pillTone = status === "Finalizado" ? "bg-neutral-400" : "bg-[#B4552D]";
---

<article class="flex flex-col border border-black/10 bg-white p-6 md:p-8">
	<span
		class={`w-fit ${pillTone} px-3 py-1 font-sans text-xs uppercase tracking-widest text-white`}
	>
		{status}
	</span>
	<h3 class="mt-6 font-serif-bold text-2xl text-black">{name}</h3>
	<ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2 font-sans text-sm text-neutral-600">
		{details.map((detail) => (
			<li>{detail}</li>
		))}
	</ul>
	<div class="mt-8 grid grid-cols-2 gap-4 border-t border-black/10 pt-6 font-sans text-sm">
		<div>
			<p class="text-xs uppercase tracking-widest text-neutral-400">Fecha</p>
			<p class="mt-1 text-neutral-700">{date}</p>
		</div>
		<div>
			<p class="text-xs uppercase tracking-widest text-neutral-400">Lugar</p>
			<p class="mt-1 text-neutral-700">{place}</p>
		</div>
	</div>
	<div class="mt-8 flex justify-center">
		<Button href="#" variant="outline">Ver detalles</Button>
	</div>
</article>