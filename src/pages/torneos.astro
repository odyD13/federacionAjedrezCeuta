---
import LatestTournaments from "../components/LatestTournaments.astro";
import TournamentCard from "../components/TournamentCard.astro";
import Layout from "../layouts/Layout.astro";
import { tournaments } from "../data/tournaments";
---

<Layout>
	<LatestTournaments />
	{
		tournaments.length > 2 && (
			<section
				id="todos-los-torneos"
				class="bg-[#FAFAFA] px-6 pb-16 md:px-16 md:pb-20 lg:px-24"
			>
                <h2 class="relative before:content-[''] before:block before:w-[60px] before:h-1 before:bg-[#B4552D] before:absolute before:-bottom-2 font-serif-bold text-2xl uppercase tracking-wide text-black md:text-3xl">
					Todos los torneos
				</h2>
				<div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2">
					{tournaments.slice(2).map((item) => (
						<TournamentCard {...item} />
					))}
				</div>
			</section>
		)
	}
</Layout>
