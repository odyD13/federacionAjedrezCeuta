---
import LatestNews from "../components/LatestNews.astro";
import NewsCard from "../components/NewsCard.astro";
import Layout from "../layouts/Layout.astro";
import { news } from "../data/news";
---

<Layout>
    <LatestNews hideCta />
    {
        news.length > 3 && (
            <section
                id="todas-las-noticias"
                class="bg-white px-6 pb-16 md:px-16 md:pb-20 lg:px-24"
            >
                <h2 class="relative before:content-[''] before:block before:w-[60px] before:h-1 before:bg-[#B4552D] before:absolute before:-bottom-2 font-serif-bold text-2xl uppercase tracking-wide text-black md:text-3xl">
                    Todas las noticias
                </h2>
                <div class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
                    {news.slice(3).map((item) => (
                        <NewsCard {...item} />
                    ))}
                </div>
            </section>
        )
    }
</Layout>
