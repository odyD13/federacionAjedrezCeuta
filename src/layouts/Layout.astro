---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/escudo.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="robots" content="index, follow" />
		<meta name="description" content="Federación de Ajedrez de Ceuta: actualidad, torneos, competiciones, reglamentos, noticias, clubes, jugadores y toda la información oficial del ajedrez ceutí." />
		<meta name="og:title" content="Federación de Ajedrez de Ceuta | Torneos, Noticias y Clubes" />
		<meta name="og:description" content="Federación de Ajedrez de Ceuta: actualidad, torneos, competiciones, reglamentos, noticias, clubes, jugadores y toda la información oficial del ajedrez ceutí." />
		<meta name="og:image" content="/escudo.webp" />
		<!-- <meta name="og:url" content="https://federacionajedrezceuta.es" /> -->

		<meta name="canonical" content="https://federacionajedrezceuta.es" />

		<title>Federación de Ajedrez de Ceuta | Web Oficial</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	@import "tailwindcss";

	@theme {
		--font-sans: "AROneSans-Regular", ui-sans-serif, system-ui, sans-serif;
		--font-serif: ui-serif, Georgia, serif;
		--font-serif-bold: "Sentient-Bold", ui-serif, Georgia, serif;
	}


	@font-face {
		font-family: "Sentient-Bold";
		src: url("/fonts/Sentient-Bold.woff2") format("woff2");
		font-weight: 700;
		font-display: swap;
		font-style: normal;
	}

	@font-face {
		font-family: "AROneSans-Regular";
		src: url("/fonts/AROneSans-Regular.woff2") format("woff2");
		font-weight: 400;
		font-display: swap;
		font-style: normal;
	}

	html,
	body {
		margin: 0;
		overflow-x: clip;
	}

	body {
		font-family: "AROneSans-Regular", ui-sans-serif, system-ui, sans-serif;
	}
</style>